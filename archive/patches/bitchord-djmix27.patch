+++ b/shared/src/commonMain/kotlin/com/music/bitchord/playback/smart/R128Limiter.kt
@@ -0,0 +1,189 @@
+package com.music.bitchord.playback.smart
+
+import kotlin.math.exp
+import kotlin.math.pow
+import kotlin.math.roundToInt
+
+/**
+ * Sum-only look-ahead limiter with EBU R128 ceilings (vc69 P1). This is a
+ * pure-Kotlin port of the Orchard render limiter (earmark dsp limiter.rs and
+ * render stage.rs limitSum, LoudnessConfig defaults: ceiling minus 0.5 dBFS,
+ * 5 ms lookahead, 80 ms release): it limits only the peaks that summing the
+ * two sides adds past the ceiling or either nearby side peak, so a hot
+ * master keeps its level and the gain stays at unity where nothing
+ * overshoots. Irrational-cutting is impossible here, but every function is
+ * scalar, reentrant, and free of framework state, so the same code can be
+ * lifted into the native render loop later without changing the numbers.
+ *
+ * The expected integration is post-mix: MixVerify deepens this from a scalar
+ * peak check into a measured repair, and the offline render path applies it
+ * to the summed buffer before handing it to the sink. It intentionally does
+ * NOT run per-player inside the audio processor chain, where a lookahead
+ * delay line would add latency and where each side must keep its own level.
+ */
+object R128Limiter {
+    /** How early the limiter starts easing into a peak, ms (Orchard LoudnessConfig default). */
+    const val LOOKAHEAD_MS = 5.0
+    /** Time constant of limiter recovery after a peak, ms (Orchard default). */
+    const val RELEASE_MS = 80.0
+    /** Peak ceiling for summed audio, dBFS (Orchard default). */
+    const val CEILING_DB = -0.5
+
+    /** Linear ceiling for a dB ceiling. */
+    fun dbToLinear(db: Double): Double = 10.0.pow(db / 20.0)
+
+    /** Linear to dB, floor at minus 70 for silence. */
+    fun linearToDb(linear: Double): Double = if (linear <= 0.0) -70.0 else (20.0 * kotlin.math.log10(linear)).coerceAtLeast(-70.0)
+
+    /**
+     * Per-frame peak across channels: the loudest absolute sample at each
+     * frame, optionally scaled by an envelope. Mirrors earmark frame_peaks.
+     */
+    fun framePeaks(channels: List<FloatArray>, envelope: FloatArray? = null): FloatArray {
+        if (channels.isEmpty()) return FloatArray(0)
+        val frames = channels[0].size
+        val peaks = FloatArray(frames)
+        for (channel in channels) {
+            val length = minOf(frames, channel.size)
+            if (envelope != null) {
+                for (frame in 0 until length) {
+                    val value = kotlin.math.abs(channel[frame] * envelope[frame])
+                    if (value > peaks[frame]) peaks[frame] = value
+                }
+            } else {
+                for (frame in 0 until length) {
+                    val value = kotlin.math.abs(channel[frame])
+                    if (value > peaks[frame]) peaks[frame] = value
+                }
+            }
+        }
+        return peaks
+    }
+
+    /**
+     * Largest value within radius frames either side of each frame
+     * (monotonic deque sliding maximum). Mirrors earmark held.
+     */
+    fun held(values: FloatArray, radius: Int): FloatArray {
+        val length = values.size
+        if (length == 0) return FloatArray(0)
+        val r = if (radius < 0) 0 else radius
+        val out = FloatArray(length)
+        val window = ArrayDeque<Int>()
+        var next = 0
+        for (index in 0 until length) {
+            val end = minOf(index + r, length - 1)
+            while (next <= end) {
+                while (window.isNotEmpty() && values[window.last()] <= values[next]) window.removeLast()
+                window.addLast(next)
+                next++
+            }
+            while (window.isNotEmpty() && window.first() + r < index) window.removeFirst()
+            out[index] = if (window.isEmpty()) 0f else values[window.first()]
+        }
+        return out
+    }
+
+    /**
+     * Smooth gain that never exceeds the required gain at any frame: each dip
+     * is approached over the lookahead window (windowed minimum then box
+     * average) and recovers through a one-pole release coefficient. Frames
+     * needing no reduction stay at unity. Mirrors earmark lookahead_gain.
+     */
+    fun lookaheadGain(required: FloatArray, lookahead: Int, release: Double): FloatArray {
+        val frames = required.size
+        if (frames == 0) return FloatArray(0)
+        val windowLength = if (lookahead < 1) 1 else lookahead
+        val minima = FloatArray(frames + windowLength - 1)
+        val window = ArrayDeque<Int>()
+        var next = 0
+        for (start in -(windowLength - 1) until frames) {
+            val end = minOf(start + windowLength - 1, frames - 1)
+            while (next <= end) {
+                while (window.isNotEmpty() && required[window.last()] >= required[next]) window.removeLast()
+                window.addLast(next)
+                next++
+            }
+            while (window.isNotEmpty() && window.first() < start) window.removeFirst()
+            minima[start + windowLength - 1] = if (window.isEmpty()) 1f else required[window.first()]
+        }
+        val averaged = FloatArray(frames)
+        var sum = 0.0
+        for (index in 0 until windowLength) sum += minima[index].toDouble()
+        averaged[0] = (sum / windowLength).toFloat()
+        for (index in 1 until frames) {
+            sum += minima[index + windowLength - 1].toDouble() - minima[index - 1].toDouble()
+            averaged[index] = (sum / windowLength).toFloat()
+        }
+        val gain = FloatArray(frames)
+        var level = 1.0
+        for (index in 0 until frames) {
+            val averagedGain = minOf(averaged[index].toDouble(), required[index].toDouble())
+            level = minOf(averagedGain, release * level + (1.0 - release) * averagedGain)
+            gain[index] = level.toFloat()
+        }
+        return gain
+    }
+
+    /**
+     * Required gain per frame for the summed mix: unity where the mixed peak
+     * stays under the ceiling and both held side peaks, the allowed ratio
+     * elsewhere. Mirrors the required-gain loop in earmark limitSum.
+     */
+    fun requiredGain(
+        mixedPeaks: FloatArray,
+        outgoingPeaks: FloatArray,
+        incomingPeaks: FloatArray,
+        ceilingLinear: Double,
+    ): FloatArray {
+        val frames = mixedPeaks.size
+        val required = FloatArray(frames)
+        for (frame in 0 until frames) {
+            val side = maxOf(ceilingLinear, outgoingPeaks.getOrElse(frame) { 0f }.toDouble(), incomingPeaks.getOrElse(frame) { 0f }.toDouble())
+            val peak = mixedPeaks[frame].toDouble()
+            required[frame] = if (peak > side) (side / peak).toFloat() else 1f
+        }
+        return required
+    }
+
+    /**
+     * Applies the sum limiter to planar mixed channels in place, using each
+     * side own held peaks when supplied. Returns the deepest reduction in
+     * dB, or zero when nothing needed limiting.
+     */
+    fun limitSum(
+        mixed: List<FloatArray>,
+        outgoingPeaks: FloatArray? = null,
+        incomingPeaks: FloatArray? = null,
+        sampleRate: Int = 48_000,
+        ceilingDb: Double = CEILING_DB,
+        lookaheadMs: Double = LOOKAHEAD_MS,
+        releaseMs: Double = RELEASE_MS,
+    ): Double {
+        if (mixed.isEmpty() || sampleRate <= 0) return 0.0
+        val frames = mixed[0].size
+        if (frames == 0) return 0.0
+        val lookahead = ((lookaheadMs / 1000.0 * sampleRate).roundToInt()).coerceAtLeast(1)
+        val ceiling = dbToLinear(ceilingDb)
+        val outgoingHeld = if (outgoingPeaks != null) held(outgoingPeaks, lookahead) else FloatArray(frames)
+        val incomingHeld = if (incomingPeaks != null) held(incomingPeaks, lookahead) else FloatArray(frames)
+        val peaks = framePeaks(mixed)
+        val required = requiredGain(peaks, outgoingHeld, incomingHeld, ceiling)
+        if (required.all { it >= 1f }) return 0.0
+        val release = exp(-1.0 / ((releaseMs / 1000.0) * sampleRate))
+        val gain = lookaheadGain(required, lookahead, release)
+        var deepest = 1.0f
+        for (channel in mixed) {
+            val length = minOf(frames, channel.size)
+            for (frame in 0 until length) {
+                channel[frame] *= gain[frame]
+                if (gain[frame] < deepest) deepest = gain[frame]
+            }
+        }
+        return linearToDb(deepest.toDouble())
+    }
+
+    /** Lookahead frames for a sample rate and millisecond budget. */
+    fun lookaheadFrames(sampleRate: Int, lookaheadMs: Double = LOOKAHEAD_MS): Int =
+        if (sampleRate <= 0) 1 else ((lookaheadMs / 1000.0 * sampleRate).roundToInt()).coerceAtLeast(1)
+}
