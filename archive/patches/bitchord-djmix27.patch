@@ -0,0 +1,44 @@
+package com.music.bitchord.playback.smart
+
+/**
+ * Post-plan dry-run verification (opensonic-style): scalars only.
+ * Checks loudness delta, peak ceiling, phase error and exit gates.
+ */
+object MixVerify {
+    const val MAX_LUFS_DELTA_DB = 3.0
+    const val MAX_PEAK_LINEAR = 0.896f
+    const val MAX_PHASE_ERROR_MS = 25.0
+    data class VerifyResult(val ok: Boolean, val reasons: List<String>)
+    fun verify(
+        lufsDeltaDb: Double,
+        peakLinear: Float,
+        phaseErrorMs: Double,
+        exitGateViolations: Int,
+    ): VerifyResult {
+        val reasons = ArrayList<String>()
+        if (kotlin.math.abs(lufsDeltaDb) > MAX_LUFS_DELTA_DB) reasons.add("lufs-delta " + lufsDeltaDb)
+        if (peakLinear > MAX_PEAK_LINEAR) reasons.add("peak " + peakLinear)
+        if (kotlin.math.abs(phaseErrorMs) > MAX_PHASE_ERROR_MS) reasons.add("phase " + phaseErrorMs)
+        if (exitGateViolations != 0) reasons.add("exit-gates " + exitGateViolations)
+        return VerifyResult(reasons.isEmpty(), reasons)
+    }
+
+    /**
+     * vc69 P1 sum-only ceiling check: what the R128 limiter (5 ms lookahead,
+     * 80 ms release, ceiling as R128Limiter) would have to take off the
+     * summed peak, given the louder nearby side peak when one is known.
+     * Zero when nothing overshoots. Irrational clipping is impossible, so a
+     * side already louder than the ceiling keeps its own level (Orchard
+     * stage.rs limitSum semantics); only the summed excess is removed.
+     */
+    fun limiterReductionDb(peakLinear: Float, sidePeakLinear: Float = 0f): Double {
+        val peak = peakLinear.toDouble()
+        if (!(peak > 0.0)) return 0.0
+        val allowed = maxOf(
+            R128Limiter.dbToLinear(R128Limiter.CEILING_DB),
+            sidePeakLinear.toDouble(),
+        )
+        if (peak <= allowed) return 0.0
+        return R128Limiter.linearToDb(allowed / peak)
+    }
+}
