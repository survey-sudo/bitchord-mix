+        assertTrue(shouldDeclineToMix(out, inn))
+        val p = plan(out, inn)
+        assertEquals(TransitionStyle.MUFFLE, p.transitionStyle)
+        assertEquals(8, p.muffleLeadBeats)
+        assertEquals("muffle", p.alternativeKind)
