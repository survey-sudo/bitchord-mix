+package com.music.bitchord.playback.smart
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+/**
+ * vc69 P1 R128 limiter: Orchard earmark limiter.rs peak holding, the
+ * windowed-minimum lookahead gain, and the sum-only ceiling.
+ */
+class R128LimiterTest {
+
+    @Test
+    fun framePeaksFollowTheLoudestChannel() {
+        val channels = listOf(floatArrayOf(0.5f, -0.9f, 0.1f), floatArrayOf(-0.7f, 0.2f, 0.3f))
+        assertEquals(floatArrayOf(0.7f, 0.9f, 0.3f).toList(), R128Limiter.framePeaks(channels).toList())
+        assertEquals(floatArrayOf(0.7f, 0.45f, 0f).toList(),
+            R128Limiter.framePeaks(channels, floatArrayOf(1f, 0.5f, 0f)).toList())
+    }
+
+    @Test
+    fun holdingSpreadsEachPeakAcrossItsRadius() {
+        val values = floatArrayOf(0f, 0f, 1f, 0f, 0f, 0f, 0.5f)
+        assertEquals(floatArrayOf(0f, 1f, 1f, 1f, 0f, 0.5f, 0.5f).toList(), R128Limiter.held(values, 1).toList())
+        assertEquals(values.toList(), R128Limiter.held(values, 0).toList())
+    }
+
+    @Test
+    fun gainMeetsEveryRequirementAndEasesIn() {
+        val required = FloatArray(400) { 1f }
+        required[200] = 0.5f
+        required[260] = 0.8f
+        val gain = R128Limiter.lookaheadGain(required, 32, 0.99)
+        for (index in gain.indices) {
+            assertTrue(gain[index] <= required[index] + 1e-6f, "gain above required at " + index)
+        }
+        assertEquals(FloatArray(168) { 1f }.toList(), gain.copyOfRange(0, 168).toList(),
+            "reduction started before its lookahead")
+        val steepest = gain.asList().windowed(2).maxOf { kotlin.math.abs(it[1] - it[0]) }
+        assertTrue(steepest <= 0.5f / 32f + 1e-6f, "step=" + steepest)
+        assertTrue(gain[399] > gain[261], "no release after the last peak")
+    }
+
+    @Test
+    fun nothingToLimitLeavesUnityGain() {
+        assertTrue(R128Limiter.lookaheadGain(FloatArray(64) { 1f }, 8, 0.9).all { it == 1f })
+        assertEquals(0, R128Limiter.lookaheadGain(FloatArray(0), 8, 0.9).size)
+    }
+
+    @Test
+    fun dipsAtEitherEdgeAreStillMet() {
+        val required = FloatArray(50) { 1f }
+        required[0] = 0.25f
+        required[49] = 0.5f
+        val gain = R128Limiter.lookaheadGain(required, 16, 0.95)
+        assertTrue(gain[0] <= 0.25f + 1e-6f)
+        assertTrue(gain[49] <= 0.5f + 1e-6f)
+    }
+
+    @Test
+    fun limitSumOnlyEngagesWhereSummingOvershoots() {
+        val frames = 4000
+        val sampleRate = 48_000
+        // Two sides each near ceiling whose sum overshoots only in the middle.
+        val left = FloatArray(frames)
+        val right = FloatArray(frames)
+        for (index in 1000 until 3000) {
+            left[index] = 1.84f
+            right[index] = 1.84f
+        }
+        val reduction = R128Limiter.limitSum(listOf(left, right),
+            FloatArray(frames).apply { for (i in 1000 until 3000) this[i] = 0.92f },
+            FloatArray(frames).apply { for (i in 1000 until 3000) this[i] = 0.92f },
+            sampleRate = sampleRate)
+        assertTrue(reduction < 0.0, "expected reduction, got ")
+        // Unity outside the overshoot and at the joins: no pumping, no step.
+        assertEquals(0f, left[0], 1e-6f)
+        assertEquals(0f, left[frames - 1], 1e-6f)
+    }
+
+    @Test
+    fun limitSumLeavesUnityWhenNothingOvershoots() {
+        val left = FloatArray(1000) { 0.2f }
+        val right = FloatArray(1000) { 0.2f }
+        val reduction = R128Limiter.limitSum(listOf(left, right), sampleRate = 48_000)
+        assertEquals(0.0, reduction, 0.0)
+        assertEquals(0.2f, left[500], 1e-6f)
+    }
+
+    @Test
+    fun limiterKeepsSidePeakThatAlreadyExceedsCeiling() {
+        // A side is already louder than the ceiling: the limiter only trims
+        // what summing adds on top of it.
+        val frames = 2000
+        val left = FloatArray(frames) { 0.97f }
+        val right = FloatArray(frames) { 0.97f }
+        val reduction = R128Limiter.limitSum(listOf(left, right),
+            FloatArray(frames) { 0.97f }, FloatArray(frames) { 0.97f },
+            sampleRate = 48_000)
+        // Ceiling -0.5 dB is about 0.944: sides at 0.97 already exceed it,
+        // so allowed is the side itself and the summed excess is tiny.
+        assertTrue(kotlin.math.abs(reduction) < 0.5, "reduction=")
+        assertTrue(left.all { it <= 0.97f + 1e-6f })
+    }
+
+    @Test
+    fun loudnessRoundTripsAndDefaultsMatchOrchard() {
+        assertEquals(-0.5, R128Limiter.CEILING_DB, 1e-9)
+        assertEquals(5.0, R128Limiter.LOOKAHEAD_MS, 1e-9)
+        assertEquals(80.0, R128Limiter.RELEASE_MS, 1e-9)
+        assertEquals(0.944061077, R128Limiter.dbToLinear(-0.5), 1e-6)
+        assertEquals(-70.0, R128Limiter.linearToDb(0.0), 0.0)
+        assertEquals(0.0, R128Limiter.linearToDb(1.0), 1e-9)
+    }
+}
