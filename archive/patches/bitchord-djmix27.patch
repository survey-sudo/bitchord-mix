+    /**
+     * True on-device umxhq Wiener stem separation over one transition window.
+     * Returns separated pair, or null (safe fallback: caller keeps dry signal).
+     */
+    fun separateWindow(
+        left: FloatArray,
+        right: FloatArray,
+        rate: Double,
