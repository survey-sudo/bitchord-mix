@@ -0,0 +1,31 @@
+package com.music.bitchord.playback.smart
+
+/**
+ * Scrub handling (djmix13). The phase the controller is in when the user
+ * seeks decides what the (possible) half-armed mix becomes:
+ *
+ * - Not shown / armed: cancel cleanly, then replan from the NEW position.
+ *   The marker/countdown is cleared so a stale plan can never fire.
+ * - Shown in ARMING (countdown visible, not audible yet): cancel the shown
+ *   countdown and replan from the new position (scrub repositioned the
+ *   mix-start; honouring the old absolute point would fire wrong).
+ * - Audible blend (FADING / TAIL with sound up): emergency 350 ms tail on
+ *   the spare, never an instant retire and never a double-fire.
+ */
+object SeekAction {
+    enum class Phase { IDLE, ARMING, FADING, TAIL, LOOP, BAILING, SLEEP }
+
+    enum class Action { CANCEL, HONOUR, EMERGENCY_TAIL }
+
+    fun decide(phase: Phase, markerShown: Boolean): Action = when (phase) {
+        Phase.FADING -> Action.EMERGENCY_TAIL
+        Phase.TAIL -> Action.EMERGENCY_TAIL
+        Phase.IDLE, Phase.ARMING, Phase.LOOP, Phase.BAILING, Phase.SLEEP -> Action.CANCEL
+    }
+
+    /**
+     * A shown plan must be invalidated once the playhead moved across its
+     * mix-start since it was shown. Returns true when it may still fire.
+     */
+    fun planStillValid(planStartMs: Long, positionMs: Long): Boolean = positionMs <= planStartMs
+}
