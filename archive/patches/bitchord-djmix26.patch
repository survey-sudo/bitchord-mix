+        // Even playWhenReady=true pre-takeover cannot be heard: the
+        // InArm sink is silent until the handover.
+        assertFalse(
+            RetireGuard.loopArmingSpareAudible(tookOver = false, handedOff = false, volume = 1.0f, playWhenReady = true),
