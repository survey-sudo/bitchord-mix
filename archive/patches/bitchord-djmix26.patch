+    private fun track(
+        id: String,
+        bpm: Double,
+        duration: Double = 180.0,
+        quality: String = TrackAnalysis.QUALITY_FULL,
+        key: String = "D minor",
+    ): TrackAnalysis {
+        val beat = 60.0 / bpm
+        val bar = 4.0 * beat
+        val downbeats = buildList {
+            var t = 0.5
+            while (t <= duration) { add(t); t += bar }
+        }
+        return TrackAnalysis(
+            status = TrackAnalysis.STATUS_READY,
+            trackId = id,
+            duration = duration,
+            bpm = bpm,
