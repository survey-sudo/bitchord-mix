+
+    @Test
+    fun vocalScoopTimesArePositiveAndMonotonic() {
+        val p = LoopMix.Plan(
+            out = pick2B(10.0), inn = pick2B(0.5), fold = 1.0, enterBars = 2, rampBars = 2, exitBars = 2,
+            totalBars = 6, outLoops = true, inLoops = true, rung = "Loop", faderSwapBeats = 1.0,
