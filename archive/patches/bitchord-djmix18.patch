+        kind = ExitKind.OUTRO_PHRASE,
+        releaseBar = bar,
+        releaseSec = sec,
+        roomBars = room,
+        vocalRoomBars = 0,
+        tailBars = 0,
+        sectionFn = SectionFn.OUTRO,
+        role = SectionRole.GROOVE,
+        energyAtRelease = 0.4f,
+        energyLevel = 4,
+        loopableRoom = true,
+        cutsSungBars = 0,
+        cutsBars = 0,
+    )
+
+    private fun entryCue(startBar: Int = 0, startSec: Double = 0.0, landingBar: Int = 8) = EntryCue(
