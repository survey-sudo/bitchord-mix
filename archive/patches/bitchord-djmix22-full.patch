+        val maskCurveOut = curveOut.map { s -> if (s.time < 156.0) 0.7 else 0.03 }
+
+        val beautiful = TrackAnalysis(
+            status = TrackAnalysis.STATUS_READY,
+            trackId = "beautiful",
+            duration = beautifulDur,
+            bpm = beautifulBpm,
+            beatInterval = 60.0 / beautifulBpm,
