+void Flanger::apply(float inL, float inR, float& wetL, float& wetR, double frameTimeSec, double sampleRate) {
+  wetL = 0;
+  wetR = 0;
+  if (!enabled || left.empty() || !(sampleRate > 0)) return;
+  const int size = int(left.size());
+  // One cycle per 8 beats: the delay sweeps slowly between 0.4 ms and the
+  // depth (<= 2 ms by policy), so the comb reads as a dissolve, not a wobble.
+  const double lfo = 0.5 * std::sin(2 * kPi * lfoHz * frameTimeSec) + 0.5;
+  const double delaySmp = (0.0004 + double(depthSeconds) * lfo) * sampleRate;
+  double fpos = std::fmod(double(pos) - delaySmp, double(size));
+  if (fpos < 0) fpos += size;
+  const int i0 = int(fpos);
+  const int i1 = (i0 + 1) % size;
+  const float frac = float(fpos - i0);
+  const float dl = left[i0] * (1.f - frac) + left[i1] * frac;
+  const float dr = right[i0] * (1.f - frac) + right[i1] * frac;
+  left[pos] = inL + dl * feedback;
+  right[pos] = inR + dr * feedback;
+  pos++;
+  if (pos >= size) pos = 0;
+  wetL = dl * wet;
+  wetR = dr * wet;
+}
