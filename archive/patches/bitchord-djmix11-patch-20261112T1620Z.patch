+  depthSeconds = float(depthSecondsIn);
+  const int size = std::clamp(int(std::lround(depthSecondsIn * sampleRate)) + 2, 4, int(sampleRate * 0.01));
+  left.assign(size, 0.f);
+  right.assign(size, 0.f);
