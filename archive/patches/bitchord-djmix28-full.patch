+        // Classic annotate path: B-side rise across the cue window is a buildup.
+        val (outId, inId) = findIds(0)
+        val curve = List(180) { i ->
+            val t = i.toDouble()
+            EnergySample(t, if (t < 50.0) 0.3 + (t - 34.0).coerceIn(0.0, 16.0) * 0.04 else 0.95)
