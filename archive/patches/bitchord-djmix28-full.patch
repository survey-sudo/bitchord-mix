index 0000000..2dcd6b6
--- /dev/null
+++ b/app/src/test/java/com/music/bitchord/playback/Djmix22AppTest.kt
@@ -0,0 +1,203 @@
+package com.music.bitchord.playback
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * djmix22 `:app` handoff discipline (vc64).
+ *
+ * Pure JVM (no ExoPlayer, no Media3 focus machinery needed): the two decisions
+ * are the controller-side half of the fix for vc63's Calvin-pair jam
+ * (mix.fire loop -> finish-guard 1.668 s later -> 350 ms emergency tail ->
+ * seek-emergency-tail double teardown, then the second song paused with no
+ * focus holder for ~70 s).
+ *
+ * [shouldRestorePlayAfterFocusSwap] is the guard the service consults before
+ * auto-resuming a session player paused by the focus swap: a user-paused
+ * player must NEVER be auto-resumed, and only a player that was audibly
+ * playing before the adoption may be restored. [loopFinishAction] is the
+ * completion routing inside finish(): a took-over, handed-off loop session
+ * with a clean exit gate completes via finishLoop(), never the emergency tail.
+ */
+class Djmix22AppTest {
+
+    // ---- Focus-swap restore -------------------------------------------------
+
+    @Test
+    fun `playing through a handoff is restored`() {
+        assertTrue(
+            shouldRestorePlayAfterFocusSwap(
+                wasPlaying = true,
+                userPaused = false,
+                focusHeld = true,
+            ),
+        )
+    }
+
+    @Test
+    fun `user-paused player is never auto-resumed`() {
+        assertFalse(
+            shouldRestorePlayAfterFocusSwap(
+                wasPlaying = true,
+                userPaused = true,
+                focusHeld = true,
+            ),
+        )
+        assertFalse(
+            shouldRestorePlayAfterFocusSwap(
+                wasPlaying = true,
+                userPaused = true,
+                focusHeld = false,
+            ),
+        )
+    }
+
+    @Test
+    fun `not-playing player is never started by the swap`() {
+        assertFalse(
+            shouldRestorePlayAfterFocusSwap(
+                wasPlaying = false,
+                userPaused = false,
+                focusHeld = true,
+            ),
+        )
+    }
+
+    @Test
+    fun `no focus held means no restore`() {
+        assertFalse(
+            shouldRestorePlayAfterFocusSwap(
+                wasPlaying = true,
+                userPaused = false,
+                focusHeld = false,
+            ),
+        )
+    }
+
+    // ---- Loop finish routing ------------------------------------------------
+
+    @Test
+    fun `took-over handed-off session completes via finishLoop not emergency tail`() {
+        assertEquals(
+            LoopFinishAction.FINISH_LOOP,
+            loopFinishAction(
+                phaseName = "LOOP_RUNNING",
+                tookOver = true,
+                handedOff = true,
+                exitGateViolations = 0,
+                audibleSpare = true,
+            ),
+        )
+    }
+
+    @Test
+    fun `arming past takeover and handoff also completes via finishLoop`() {
+        assertEquals(
+            LoopFinishAction.FINISH_LOOP,
+            loopFinishAction(
+                phaseName = "LOOP_ARMING",
+                tookOver = true,
+                handedOff = true,
+                exitGateViolations = 0,
+                audibleSpare = true,
+            ),
+        )
+    }
+
+    @Test
+    fun `pre-handoff loop mix keeps the emergency tail for its settle seek`() {
+        assertEquals(
+            LoopFinishAction.EMERGENCY_TAIL,
+            loopFinishAction(
+                phaseName = "LOOP_RUNNING",
+                tookOver = true,
+                handedOff = false,
+                exitGateViolations = 0,
+                audibleSpare = true,
+            ),
+        )
+    }
+
+    @Test
+    fun `not took over means emergency tail`() {
+        assertEquals(
+            LoopFinishAction.EMERGENCY_TAIL,
+            loopFinishAction(
+                phaseName = "LOOP_RUNNING",
+                tookOver = false,
+                handedOff = false,
+                exitGateViolations = 0,
+                audibleSpare = true,
+            ),
+        )
+    }
+
+    @Test
+    fun `dirty exit gate keeps the emergency tail`() {
+        assertEquals(
+            LoopFinishAction.EMERGENCY_TAIL,
+            loopFinishAction(
+                phaseName = "LOOP_RUNNING",
+                tookOver = true,
+                handedOff = true,
+                exitGateViolations = 2,
+                audibleSpare = true,
+            ),
+        )
+    }
+
+    @Test
+    fun `unprovable gate keeps the emergency tail`() {
+        // -1: no session (the finishLoop re-entry, or a nulled renderer).
+        assertEquals(
+            LoopFinishAction.EMERGENCY_TAIL,
+            loopFinishAction(
+                phaseName = "LOOP_RUNNING",
+                tookOver = false,
+                handedOff = true,
+                exitGateViolations = -1,
+                audibleSpare = true,
+            ),
+        )
+    }
+
+    @Test
+    fun `classic audible spare keeps the emergency tail`() {
+        assertEquals(
+            LoopFinishAction.EMERGENCY_TAIL,
+            loopFinishAction(
+                phaseName = "FADING",
+                tookOver = false,
+                handedOff = true,
+                exitGateViolations = 0,
+                audibleSpare = true,
+            ),
+        )
+    }
+
+    @Test
+    fun `inaudible spare finishes at once even outside a mix`() {
+        assertEquals(
+            LoopFinishAction.FINISH,
+            loopFinishAction(
+                phaseName = "IDLE",
+                tookOver = false,
+                handedOff = false,
+                exitGateViolations = 0,
+                audibleSpare = false,
+            ),
+        )
+        assertEquals(
+            LoopFinishAction.FINISH,
+            loopFinishAction(
+                phaseName = "LOOP_RUNNING",
+                tookOver = true,
+                handedOff = true,
+                exitGateViolations = 0,
+                audibleSpare = false,
+            ),
+        )
+    }
+}
diff --git a/app/src/test/java/com/music/bitchord/playback/Djmix23AppTest.kt b/app/src/test/java/com/music/bitchord/playback/Djmix23AppTest.kt
new file mode 100644
index 0000000..3f21ccf
--- /dev/null
+++ b/app/src/test/java/com/music/bitchord/playback/Djmix23AppTest.kt
@@ -0,0 +1,222 @@
+package com.music.bitchord.playback
+
+import com.music.bitchord.playback.loopmix.LoopMixSession
+import com.music.bitchord.playback.smart.EntryCue
+import com.music.bitchord.playback.smart.EntryKind
+import com.music.bitchord.playback.smart.ExitCue
+import com.music.bitchord.playback.smart.ExitKind
+import com.music.bitchord.playback.smart.LoopMix
+import com.music.bitchord.playback.smart.MixTemplate
+import com.music.bitchord.playback.smart.PhraseChoice
+import com.music.bitchord.playback.smart.PhrasePlanner
+import com.music.bitchord.playback.smart.SectionFn
+import com.music.bitchord.playback.smart.SectionRole
+import com.music.bitchord.playback.smart.TransitionMoves
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * djmix23 `:app` session-adoption discipline (vc65).
+ *
+ * Pure JVM (no ExoPlayer): the vc64 06:23 freeze (Calvin pair ->
+ * "This Is What You Came For" -> "One Kiss") left song 2 paused at 0:00 on
+ * two consecutive loop mixes. Video + `mix.pause.detected` prove the pause is
+ * reason 1 = USER_REQUEST (Media3 1.11.0), not focus loss (2): the session
+ * was adopted onto a never-started incoming player. Two guards now keep that
+ * shape out of driveLoopMix and finishLoop:
+ *
+ * 1. [canAdoptSessionPlayer]: `handOff` only once `loopIncomingStarted`.
+ *   The loop clock's hold geometry can schedule the start (inStartAt) after
+ *   the session handoff (handoffAt) — driveLoopMix holds the adoption until
+ *   the start, which the renderer makes inaudible.
+ * 2. [LoopMixSession.clampIncomingStartAt]: inStartAt is clamped strictly
+ *   before elementAt with a decode lead, so the start cannot fall off the
+ *   end of the mix entirely; finishLoop additionally starts the incoming
+ *   player first if it was somehow still unstarted. The geometry tests pin
+ *   both orderings against the real planner output.
+ */
+class Djmix23AppTest {
+
+    // ---- Adoption guard ---------------------------------------------------
+
+    @Test
+    fun `unstarted incoming player is never adopted as the session`() {
+        assertFalse(
+            "canAdoptSessionPlayer(false) must be false: adopting a never-started " +
+                "player makes the session a paused position-0 player (vc64 06:23 freeze)",
+            canAdoptSessionPlayer(loopIncomingStarted = false),
+        )
+    }
+
+    @Test
+    fun `started incoming player is adopted as the session`() {
+        assertTrue(canAdoptSessionPlayer(loopIncomingStarted = true))
+    }
+
+    // ---- Geometry helpers (copied cues; the clock math itself is the real one) ----
+
+    private fun exitCue(bar: Int, sec: Double, room: Int) = ExitCue(
+        kind = ExitKind.OUTRO_PHRASE,
+        releaseBar = bar,
+        releaseSec = sec,
+        roomBars = room,
+        vocalRoomBars = 0,
+        tailBars = 0,
+        sectionFn = SectionFn.OUTRO,
+        role = SectionRole.GROOVE,
+        energyAtRelease = 0.4f,
+        energyLevel = 4,
+        loopableRoom = true,
+        cutsSungBars = 0,
+        cutsBars = 0,
+    )
+
+    private fun entryCue(landingBar: Int) = EntryCue(
+        kind = EntryKind.HEAD,
+        startBar = 0,
+        startSec = 0.0,
+        landingBar = landingBar,
+        landingFn = SectionFn.INTRO,
+        landingRole = SectionRole.GROOVE,
+        leadInBars = landingBar,
+        leadInVocal = 0f,
+        leadInLoopable = true,
+        energyAtLanding = 0.4f,
+        energyLevel = 4,
+        trimmedBars = 0,
+        pickupBeats = 0f,
+    )
+
+    private fun choiceFor(template: MixTemplate, overlapBars: Int, prepBars: Int) = PhraseChoice(
+        template = template,
+        rung = PhrasePlanner.rungOf(template),
+        score = 0.85,
+        exit = exitCue(bar = 72, sec = 170.0, room = overlapBars),
+        entry = entryCue(landingBar = overlapBars),
+        overlapBars = overlapBars,
+        swapBar = -overlapBars / 2.0,
+        tailBeats = 1.0,
+        loopK = 0,
+        echoGated = template == MixTemplate.M6,
+        vocalProduct = 0f,
+        tempoPrepBars = prepBars,
+        echoDelayBeats = 0.75,
+        echoDelayName = "ECHO_DELAY_BEATS",
+        swapRampMs = 120,
+        swapRampName = "SWAP_RAMP_BLEND_MS",
+        tempoPolicy = "TEMPO_POLICY=b",
+        vocalOverlapBeats = 0.0,
+        energyDelta = 0f,
+        struct = 0.9,
+        vocalScore = 0.9,
+        phraseScore = 0.9,
+        energyScore = 0.9,
+        lengthScore = 0.9,
+        keyScore = 0.9,
+        tempoScore = 0.9,
+        cost = 0.0,
+    )
+
+    private fun clockFor(overlapBars: Int, prepBars: Int, outBpm: Double = 124.341, inBpm: Double = 124.250) =
+        LoopMix.Clock(
+            TransitionMoves.compile(
+                choiceFor(MixTemplate.M1, overlapBars, prepBars),
+                outBpm = outBpm,
+                inBpm = inBpm,
+            ).plan,
+        )
+
+    @Test
+    fun `calvin hold geometry reorders start after handoff but before element`() {
+        // Order (i): handoffAt < inStartAt < elementAt — the live vc64 shape.
+        // handoffAt ~0.97, hold ~1.93, elementAt ~7.73. The adoption guard
+        // holds the handoff until the start; the clamp preserves the decode
+        // lead before the element.
+        val clock = clockFor(overlapBars = 1, prepBars = 0)
+        assertTrue("hold must be > 0 (hold branch live), was ${clock.incomingHoldSec}", clock.incomingHoldSec > 0.0)
+        assertTrue(
+            "handoverTrack must be >= 2.5 (branch precondition), was ${clock.elementTrackTime}",
+            clock.elementTrackTime >= 2.5,
+        )
+        val (inStartAt, inStartTrack) = LoopMixSession.incomingStartFor(clock)
+        assertTrue(
+            "inStartAt $inStartAt must be AFTER handoffAt ${clock.handoffAt}: " +
+                "that reorder is why vc64 adopted the session paused",
+            inStartAt > clock.handoffAt + 0.5,
+        )
+        assertTrue(
+            "inStartAt $inStartAt must stay a decode lead before elementAt " +
+                "${clock.elementAt} (clamped), not fall off the end of the mix",
+            inStartAt < clock.elementAt - LoopMixSession.STARTUP_LEAD + 1e-9,
+        )
+        assertTrue("inStartTrack must sit at track start (video frozen 0:00), was $inStartTrack", inStartTrack < 0.5)
+        assertEquals(0.5, LoopMixSession.STARTUP_LEAD, 1e-9)
+    }
+
+    @Test
+    fun `start past elementAt is clamped strictly before the end`() {
+        // Order (ii): elementAt <= pre-clamp inStartAt — the clamp keeps the
+        // start inside the mix with exactly the decode lead, so the start
+        // still fires and the mix completes onto a started player instead of
+        // an unstarted one.
+        val clamped = LoopMixSession.clampIncomingStartAt(inStartAt = 8.0, elementAt = 8.0)
+        assertEquals("a start at elementAt must clamp to a lead before it", 7.5, clamped, 1e-9)
+        val alsoClamped = LoopMixSession.clampIncomingStartAt(inStartAt = 9.0, elementAt = 8.0)
+        assertEquals("a start past elementAt must clamp to a lead before it", 7.5, alsoClamped, 1e-9)
+        val untouched = LoopMixSession.clampIncomingStartAt(inStartAt = 1.93, elementAt = 7.73)
+        assertEquals("an in-mix start must be untouched", 1.93, untouched, 1e-9)
+    }
+
+    @Test
+    fun `element past start never lands on a never-started player`() {
+        // Sweep the real planner grid used by the probe: every plan's
+        // incoming start must satisfy handoffAt-agnostic invariants the
+        // handoff guard and finishLoop pre-start rely on: start strictly
+        // inside the mix with decode head-room, track position at the start.
+        for (ov in 1..16) {
+            for (prep in 0..12) {
+                val clock = clockFor(overlapBars = ov, prepBars = prep)
+                val (inStartAt, inStartTrack) = LoopMixSession.incomingStartFor(clock)
+                assertTrue(
+                    "ov=$ov prep=$prep: inStartAt $inStartAt must be < elementAt ${clock.elementAt}",
+                    inStartAt < clock.elementAt,
+                )
+                assertTrue(
+                    "ov=$ov prep=$prep: inStartAt $inStartAt must keep a decode lead before " +
+                        "elementAt ${clock.elementAt}",
+                    inStartAt <= clock.elementAt - LoopMixSession.STARTUP_LEAD + 1e-9,
+                )
+                assertTrue("ov=$ov prep=$prep: inStartTrack $inStartTrack must be >= 0", inStartTrack >= 0.0)
+                assertTrue(
+                    "ov=$ov prep=$prep: inStartTrack $inStartTrack must be <= handoverTrack " +
+                        "${clock.elementTrackTime}",
+                    inStartTrack <= clock.elementTrackTime + 1e-9,
+                )
+            }
+        }
+    }
+
+    // ---- User-pause-never-resumed invariant (vc65) ------------------------
+
+    @Test
+    fun `user pause is never auto-resumed by the handoff guard`() {
+        assertFalse(
+            shouldRestorePlayAfterFocusSwap(wasPlaying = true, userPaused = true, focusHeld = true),
+        )
+        assertFalse(
+            shouldRestorePlayAfterFocusSwap(wasPlaying = true, userPaused = true, focusHeld = false),
+        )
+    }
+
+    @Test
+    fun `playing through a handoff still restores only when focus is held`() {
+        assertTrue(
+            shouldRestorePlayAfterFocusSwap(wasPlaying = true, userPaused = false, focusHeld = true),
+        )
+        assertFalse(
+            shouldRestorePlayAfterFocusSwap(wasPlaying = true, userPaused = false, focusHeld = false),
+        )
+    }
+}
diff --git a/app/src/test/java/com/music/bitchord/playback/Djmix24AppTest.kt b/app/src/test/java/com/music/bitchord/playback/Djmix24AppTest.kt
new file mode 100644
index 0000000..171c8b5
--- /dev/null
+++ b/app/src/test/java/com/music/bitchord/playback/Djmix24AppTest.kt
@@ -0,0 +1,222 @@
+package com.music.bitchord.playback
+
+import com.music.bitchord.playback.smart.EntryCue
+import com.music.bitchord.playback.smart.EntryKind
+import com.music.bitchord.playback.smart.ExitCue
+import com.music.bitchord.playback.smart.ExitKind
+import com.music.bitchord.playback.smart.LoopMix
+import com.music.bitchord.playback.smart.MixTemplate
+import com.music.bitchord.playback.smart.PhraseChoice
+import com.music.bitchord.playback.smart.SectionFn
+import com.music.bitchord.playback.smart.SectionRole
+import com.music.bitchord.playback.smart.TransitionMoves
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * djmix24 `:app` suite (vc66).
+ *
+ * Bug A1 regression: loopPlanFor (LoopMix.plan) and nativeBridge
+ * (LoopMix.bridge) both clear loopScript = null, so LoopMixSession.build
+ * previously saw script = null and never armed the flanger/buildup. The
+ * Plan scalar carrier (flanger / buildupRoll / reverbWash / hpSweepEndHz)
+ * now carries the deterministic FX on BOTH paths, and LoopMixSession.build
+ * honours effectivePlan even when script is null. These tests pin the
+ * scalars on both paths plus the vc65 session invariants.
+ */
+class Djmix24AppTest {
+
+    private fun exitCue(room: Int = 8) = ExitCue(
+        kind = ExitKind.OUTRO_PHRASE,
+        releaseBar = 72,
+        releaseSec = 170.0,
+        roomBars = room,
+        vocalRoomBars = 0,
+        tailBars = 0,
+        sectionFn = SectionFn.OUTRO,
+        role = SectionRole.GROOVE,
+        energyAtRelease = 0.4f,
+        energyLevel = 4,
+        loopableRoom = room >= 4,
+        cutsSungBars = 0,
+        cutsBars = 0,
+    )
+
+    private fun entryCue() = EntryCue(
+        kind = EntryKind.HEAD,
+        startBar = 0,
+        startSec = 0.0,
+        landingBar = 8,
+        landingFn = SectionFn.INTRO,
+        landingRole = SectionRole.GROOVE,
+        leadInBars = 8,
+        leadInVocal = 0f,
+        leadInLoopable = true,
+        energyAtLanding = 0.4f,
+        energyLevel = 4,
+        trimmedBars = 0,
+        pickupBeats = 0f,
+    )
+
+    private fun choice(vocalOverlap: Double = 0.0): PhraseChoice = PhraseChoice(
+        template = MixTemplate.M1,
+        rung = "Phrase",
+        score = 0.85,
+        exit = exitCue(),
+        entry = entryCue(),
+        overlapBars = 8,
+        swapBar = 0.0,
+        tailBeats = 0.0,
+        loopK = 0,
+        echoGated = false,
+        vocalProduct = 0f,
+        tempoPrepBars = 0,
+        echoDelayBeats = 0.75,
+        echoDelayName = "ECHO_DELAY_BEATS",
+        swapRampMs = 120,
+        swapRampName = "SWAP_RAMP_BLEND_MS",
+        tempoPolicy = "TEMPO_POLICY=b",
+        vocalOverlapBeats = vocalOverlap,
+        energyDelta = 0f,
+        struct = 0.9,
+        vocalScore = 0.9,
+        phraseScore = 0.9,
+        energyScore = 0.9,
+        lengthScore = 0.9,
+        keyScore = 0.9,
+        tempoScore = 0.9,
+        cost = 0.0,
+    )
+
+    // ---- Bug A1: FX carrier on loopPlanFor path (LoopMix.plan) ----
+
+    @Test
+    fun loopPlanPathCarriesNonNullFxOnEdmPair() {
+        val out = track("out", 124.34)
+        val inn = track("in", 124.25)
+        val clear = emptyList<LoopMix.Span>()
+        val plan = LoopMix.plan(out, out.duration, inn, inn.duration, 0.0, clear, clear)
+        assertNotNull(plan)
+        // Non-null FX/buildup configuration (Bug A1 scalar carrier).
+        assertTrue("loopPlanFor EDM must carry flanger=true (Bug A1)", plan!!.flanger)
+        assertTrue("loopPlanFor EDM must carry buildupRoll=true", plan.buildupRoll)
+        assertTrue("hpSweep 420..600Hz, got ${plan.hpSweepEndHz}", plan.hpSweepEndHz in 420f..600f)
+        assertTrue("EDM drop carries reverb release", plan.reverbWash)
+    }
+
+    @Test
+    fun bridgePathCarriesNonNullFxOnEdmPair() {
+        val out = track("out", 124.34)
+        val inn = track("in", 124.25)
+        val clear = emptyList<LoopMix.Span>()
+        val plan = LoopMix.bridge(out, out.duration, inn, inn.duration, 0.0, clear, clear)
+        assertNotNull(plan)
+        assertTrue("bridge EDM must carry flanger=true (Bug A1)", plan!!.flanger)
+        // Bridge blend on EDM also carries the roll + sweep.
+        assertTrue("bridge EDM must carry buildupRoll", plan.buildupRoll)
+    }
+
+    @Test
+    fun dualVocalBridgeNeverFlanges() {
+        // Phrase path: vocalOverlapBeats >= 1.0 must never flange/roll.
+        val script = TransitionMoves.compile(choice(vocalOverlap = 2.0), outBpm = 124.34, inBpm = 124.25)
+        assertFalse(script.plan.flanger)
+        assertFalse(script.plan.buildupRoll)
+        assertFalse(script.flanger)
+        // Bridge path: clean instrumental loops (even on vocal tracks)
+        // DO flange (loops are instrumental); sung loops must not.
+        // Clean loops (lyrics-vouched, no mask) -> EDM flanges.
+        val cleanOut = track("out", 124.34)
+        val cleanIn = track("in", 124.25)
+        val clear = emptyList<LoopMix.Span>()
+        val cleanPlan = LoopMix.bridge(cleanOut, cleanOut.duration, cleanIn, cleanIn.duration, 0.0, clear, clear)
+        assertNotNull(cleanPlan)
+        assertTrue("clean-loop EDM bridge must flange", cleanPlan!!.flanger)
+        // Sung loops (mask calls the bar sung) -> bridge echoes or is null,
+        // never flanges over sung bars.
+        val sungOut = trackSung("out", 124.34)
+        val sungIn = trackSung("in", 124.25)
+        val sungPlan = LoopMix.bridge(sungOut, sungOut.duration, sungIn, sungIn.duration, 0.0, null, null)
+        if (sungPlan != null) {
+            assertFalse("sung-loop bridge must never flange", sungPlan.flanger)
+            assertFalse("sung-loop bridge must never roll", sungPlan.buildupRoll)
+        }
+    }
+
+    // ---- vc65 preserved invariants ----
+
+    @Test
+    fun canAdoptSessionPlayerPreserved() {
+        assertFalse(canAdoptSessionPlayer(false))
+        assertTrue(canAdoptSessionPlayer(true))
+    }
+
+    // ---- Rung 0 consecutive-album guard ----
+
+    @Test
+    fun consecutiveAlbumPrefersGapless() {
+        assertTrue(isConsecutiveAlbumTrack("Album", "id", 3, "Album", "id", 4))
+        assertFalse(isConsecutiveAlbumTrack("Album", "id", 3, "Album", "id", 5))
+        assertFalse(isConsecutiveAlbumTrack("", "", 3, "", "", 4))
+        assertFalse(isConsecutiveAlbumTrack("Album", "id", 0, "Album", "id", 1))
+        assertFalse(isConsecutiveAlbumTrack("A", "id1", 3, "A", "id2", 4))
+    }
+
+    // ---- FX rotation varied, deterministic, anti-repeat by pair hash ----
+
+    @Test
+    fun fxRotationVariedAndDeterministic() {
+        val slots = (0 until 100).map { TransitionMoves.fxSlot("track$it", "track${it + 1}") }.toSet()
+        assertTrue("rotation must vary", slots.size >= 3)
+        assertEquals(TransitionMoves.fxSlot("a", "b"), TransitionMoves.fxSlot("a", "b"))
+        // Anti-repeat: consecutive queue pairs (a->b, b->c) rarely repeat the
+        // same slot twice in a row when the pairs differ.
+        var repeats = 0
+        var total = 0
+        for (i in 0 until 100) {
+            total++
+            if (TransitionMoves.fxSlot("t$i", "t${i + 1}") == TransitionMoves.fxSlot("t${i + 1}", "t${i + 2}")) repeats++
+        }
+        // Random hash repeats ~25%; the cap proves it is not a constant effect.
+        assertTrue("rotation must not be constant (repeats=$repeats/$total)", repeats < total * 0.6)
+    }
+
+    private fun trackSung(id: String, bpm: Double): com.music.bitchord.playback.smart.TrackAnalysis {
+        val base = track(id, bpm, vocal = 0.9)
+        val fps = 10.0
+        val sung = com.music.bitchord.playback.smart.CurveWindow(0.0, fps, FloatArray((180.0 * fps).toInt()) { 0.9f })
+        return base.copy(vocalWindows = listOf(sung))
+    }
+
+    private fun track(id: String, bpm: Double, vocal: Double = 0.3): com.music.bitchord.playback.smart.TrackAnalysis {
+        val beat = 60.0 / bpm
+        val downbeats = List(((180.0 / (4 * beat)) + 1).toInt()) { it * 4 * beat + 0.5 }
+        return com.music.bitchord.playback.smart.TrackAnalysis(
+            status = com.music.bitchord.playback.smart.TrackAnalysis.STATUS_READY,
+            trackId = id,
+            duration = 180.0,
+            bpm = bpm,
+            beatInterval = beat,
+            beatConfidence = 0.9,
+            downbeats = downbeats,
+            firstBeat = 0.5,
+            key = "C major",
+            keyConfidence = 0.9,
+            energyCurve = List(180) { com.music.bitchord.playback.smart.EnergySample(it.toDouble(), 1.0) },
+            vocalProbability = vocal,
+            quality = com.music.bitchord.playback.smart.TrackAnalysis.QUALITY_FULL,
+            levelWindows = listOf(
+                com.music.bitchord.playback.smart.CurveWindow(
+                    0.0,
+                    com.music.bitchord.playback.smart.LEVEL_FRAME_RATE,
+                    FloatArray((180.0 * com.music.bitchord.playback.smart.LEVEL_FRAME_RATE).toInt()) {
+                        com.music.bitchord.playback.smart.levelFromRms(0.3).toFloat()
+                    },
+                ),
+            ),
+        )
+    }
