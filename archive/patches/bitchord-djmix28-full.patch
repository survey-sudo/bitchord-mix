diff --git a/shared/src/commonMain/kotlin/com/music/bitchord/playback/smart/BeatFlow.kt b/shared/src/commonMain/kotlin/com/music/bitchord/playback/smart/BeatFlow.kt
new file mode 100644
index 0000000..b6ae686
--- /dev/null
+++ b/shared/src/commonMain/kotlin/com/music/bitchord/playback/smart/BeatFlow.kt
@@ -0,0 +1,220 @@
+package com.music.bitchord.playback.smart
+
+import kotlin.math.PI
+import kotlin.math.cos
+import kotlin.math.floor
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.sin
+
+/**
+ * Beat-flow continuity ranking (vc69 P2): how well the beat the listener
+ * already hears carries through a candidate overlap and past the handoff.
+ * Ported from Orchard transitionFlow.js beatFlow (FLOW_SAMPLES 16, equal
+ * power weighting, deficit and late-drop accounting). BitChord has no bass
+ * curve per se; the low-band energy curve plays that role, normalized
+ * against each track own reference so presence reads in the same 0..1 terms
+ * Orchard uses for bass levels. Every measure is neutral (0.5) when the
+ * worker sent no curves, exactly like Orchard.
+ *
+ * Scores feed the alternative-transition ranker: when several rescue
+ * techniques fit a declined pair, the one whose beat the listener is
+ * already hearing survives the overlap wins, which is the same judgment
+ * Orchard makes with its flow weight (0.18) against the coarse frame
+ * measures it supersedes.
+ */
+object BeatFlow {
+    /** Overlap samples per candidate (transitionFlow.js FLOW_SAMPLES). */
+    const val FLOW_SAMPLES = 16
+    /** Bass level under which a passage carries no kick or bassline. */
+    const val BASS_SILENT = 0.1
+    /** Bass level at which the beat counts as fully in. */
+    const val BASS_FULL = 0.5
+    /** Beat presence counted as heard for the shared-beat ratio. */
+    const val SHARED_BEAT = 0.5
+    /** Waiting this long for the beat after the old song leaves is a full failure. */
+    const val MAX_WAIT_SECONDS = 8.0
+    /** Seconds of incoming passed its first beat that skipping charges against. */
+    const val MAX_SKIP_SECONDS = 45.0
+    /** A beat that stopped this many beats before counts as the listeners beat. */
+    const val RECENT_BEATS = 8
+
+    /** One candidate overlap scored for beat continuity. Neutral without curves. */
+    data class FlowResult(
+        val score: Double = 0.5,
+        val coverage: Double = 0.0,
+        val sharedBeat: Double = 0.0,
+        val lateDrop: Double = 0.0,
+        val meanDeficit: Double = 0.0,
+        val worstDeficit: Double = 0.0,
+        val waitSeconds: Double = 0.0,
+        val skip: Double = 0.0,
+    )
+
+    /** Mean low-band energy on a track between two seconds, or null without a curve. */
+    fun meanCurve(curve: List<EnergySample>, from: Double, until: Double): Double? {
+        if (curve.isEmpty() || until <= from) return null
+        var sum = 0.0
+        var count = 0
+        for (point in curve) {
+            if (point.time >= from && point.time < until && point.energy.isFinite() && point.energy >= 0.0) {
+                sum += point.energy
+                count++
+            }
+        }
+        return if (count == 0) null else sum / count
+    }
+
+    /** The track own loud-end reference for bass levels: upper decile, at least a quarter of max. */
+    fun bassReference(analysis: TrackAnalysis): Double? {
+        val energies = analysis.lowEnergyCurve.map { it.energy }.filter { it.isFinite() && it >= 0.0 }.sorted()
+        if (energies.isEmpty()) return null
+        val upperDecile = energies[(energies.lastIndex * 0.9).toInt()]
+        val reference = max(upperDecile, (energies.lastOrNull() ?: 0.0) * 0.25)
+        return reference.takeIf { it > 1e-9 }
+    }
+
+    /**
+     * Beat presence near a track second: 0 in a beatless passage, 1 once
+     * kick and bass are in. Null without a low-band curve.
+     */
+    fun beatPresenceAt(analysis: TrackAnalysis, time: Double): Double? {
+        val curve = analysis.lowEnergyCurve
+        if (curve.isEmpty() || !time.isFinite()) return null
+        val reference = bassReference(analysis) ?: return null
+        val level = meanCurve(curve, time - 0.5, time + 0.5) ?: return null
+        val presence = ((level / reference) - BASS_SILENT) / (BASS_FULL - BASS_SILENT)
+        return presence.coerceIn(0.0, 1.0)
+    }
+
+    /** Track time where the beat first comes in. Null when never or unmeasured. */
+    fun firstBeat(analysis: TrackAnalysis): Double? {
+        if (analysis.lowEnergyCurve.isEmpty()) return null
+        var time = analysis.firstBeat
+        val end = curveEnd(analysis)
+        if (end == null) return null
+        while (time + 0.5 <= end) {
+            if ((beatPresenceAt(analysis, time) ?: 0.0) >= 0.5) return time
+            time += 0.5
+        }
+        return null
+    }
+
+    private fun curveEnd(analysis: TrackAnalysis): Double? {
+        val curve = analysis.lowEnergyCurve
+        if (curve.isEmpty()) return null
+        return curve.maxOfOrNull { it.time }
+    }
+
+    private fun recentBeat(analysis: TrackAnalysis, time: Double, beatInterval: Double): Double? {
+        var level = beatPresenceAt(analysis, time) ?: return null
+        if (beatInterval <= 0.0 || !beatInterval.isFinite()) return level
+        for (beat in 1..RECENT_BEATS) {
+            level = max(level, beatPresenceAt(analysis, time - beat * beatInterval) ?: 0.0)
+        }
+        return level
+    }
+
+    private fun within(fraction: Double, start: Double, end: Double): Double =
+        if (end > start) ((fraction - start) / (end - start)).coerceIn(0.0, 1.0)
+        else if (fraction >= start) 1.0 else 0.0
+
+    /**
+     * Scores one candidate overlap. outStart/inCue are source times, duration
+     * the overlap length in outgoing seconds, rates the playback rates.
+     * A short unmatched fade is only sampled at its end (Orchard samples
+     * once when not beatmatched): callers pass the matched flag for the
+     * dense sampling the gate needs.
+     */
+    fun beatFlow(
+        outgoing: TrackAnalysis,
+        incoming: TrackAnalysis,
+        outStart: Double,
+        inCue: Double,
+        durationSeconds: Double,
+        outRate: Double = 1.0,
+        inRate: Double = 1.0,
+        anchorTime: Double? = null,
+        matched: Boolean = false,
+    ): FlowResult {
+        if (outgoing.lowEnergyCurve.isEmpty() || incoming.lowEnergyCurve.isEmpty() || !(durationSeconds > 0.0)) {
+            return FlowResult()
+        }
+        val reference = recentBeat(outgoing, outStart, outgoing.beatInterval) ?: return FlowResult()
+        var deficit = 0.0
+        var worst = 0.0
+        var shared = 0
+        var known = 0
+        var late = 0
+        var secondHalf = 0
+        val outStep = if (outRate.isFinite() && outRate > 0.0) outRate else 1.0
+        val inStep = if (inRate.isFinite() && inRate > 0.0) inRate else 1.0
+        val steps = if (matched) FLOW_SAMPLES else 0
+        val from = if (matched) 0 else 1
+        val to = maxOf(1, steps)
+        for (index in from..to) {
+            val fraction = if (matched) index.toDouble() / steps.toDouble() else 1.0
+            val moment = fraction * durationSeconds
+            val left = beatPresenceAt(outgoing, outStart + moment * outStep)
+            val right = beatPresenceAt(incoming, inCue + moment * inStep)
+            if (left == null || right == null) continue
+            val outWeight = cos(within(fraction, 0.0, 1.0) * PI / 2.0)
+            val inWeight = sin(within(fraction, 0.0, 1.0) * PI / 2.0)
+            val heard = min(1.0, outWeight * left + inWeight * right)
+            val loss = max(0.0, reference - heard)
+            deficit += loss
+            worst = max(worst, loss)
+            if (matched && fraction >= 0.5) {
+                secondHalf++
+                if (right < 0.5) late++
+            }
+            if (left >= SHARED_BEAT && right >= SHARED_BEAT) shared++
+            known++
+        }
+        if (known == 0) return FlowResult()
+        val inEnd = inCue + durationSeconds * inStep
+        var waitSeconds = 0.0
+        var scan = inEnd
+        while (waitSeconds < MAX_WAIT_SECONDS) {
+            val presence = beatPresenceAt(incoming, scan) ?: break
+            if (presence >= 0.5) break
+            waitSeconds += 0.5
+            scan += 0.5
+        }
+        val meanDeficit = deficit / known.toDouble()
+        val lateDrop = if (secondHalf > 0) (late.toDouble() / secondHalf) * reference else 0.0
+        val start = firstBeat(incoming) ?: 0.0
+        val anchor = anchorTime ?: inEnd
+        val skip = ((anchor - start).coerceIn(0.0, MAX_SKIP_SECONDS) / MAX_SKIP_SECONDS)
+        val penalty = meanDeficit * 0.5 + worst * 0.5 + lateDrop * 0.3 +
+            minOf(waitSeconds / MAX_WAIT_SECONDS, 1.0) * 0.6 + minOf(skip, 1.0) * 0.4
+        return FlowResult(
+            score = (1.0 - penalty).coerceIn(0.0, 1.0),
+            coverage = known.toDouble() / (FLOW_SAMPLES + 1).toDouble(),
+            sharedBeat = shared.toDouble() / known.toDouble(),
+            lateDrop = lateDrop,
+            meanDeficit = meanDeficit,
+            worstDeficit = worst,
+            waitSeconds = waitSeconds,
+            skip = skip,
+        )
+    }
+
+    /**
+     * Ranking score for as many candidate overlaps as fit: Orchard weights
+     * beat flow 0.18 against the coarse frame measures, so the rank blends
+     * the candidate own confidence with its flow score the same way.
+     */
+    fun rankScore(confidence: Double, flow: FlowResult): Double {
+        val safeFlow = if (flow.coverage > 0.0) flow.score else 0.5
+        return confidence * 0.82 + safeFlow * 0.18
+    }
+
+    /** Whole-beat duration for a beatless run: floor to whole beats, capped. */
+    fun wholeBeats(durationSeconds: Double, beatInterval: Double, minimumSeconds: Double = 4.0): Double {
+        if (beatInterval <= 0.0 || !beatInterval.isFinite()) return 0.0
+        val beats = floor(durationSeconds / beatInterval).toLong()
+        val whole = beats * beatInterval
+        return if (whole < minimumSeconds) 0.0 else whole
+    }
+}
diff --git a/shared/src/commonMain/kotlin/com/music/bitchord/playback/smart/CatchUpPlanner.kt b/shared/src/commonMain/kotlin/com/music/bitchord/playback/smart/CatchUpPlanner.kt
new file mode 100644
index 0000000..40cfaba
--- /dev/null
+++ b/shared/src/commonMain/kotlin/com/music/bitchord/playback/smart/CatchUpPlanner.kt
@@ -0,0 +1,212 @@
+package com.music.bitchord.playback.smart
+
+import kotlin.math.abs
+import kotlin.math.roundToLong
+
+/**
+ * Late-scrub catch-up re-anchoring (djmix14). When the playhead has already
+ * crossed [TransitionPlan.transitionStart] (scrubbed near EOF), the planner
+ * would otherwise show a dead 0s countdown whose start is 15-20 s in the
+ * past and never fire. This pure planner re-anchors a tight, beat-snapped
+ * DJ move just ahead of the playhead so the scrub still mixes musically
+ * instead of playing dry to EOF.
+ *
+ * Scalars only: BPM, downbeats, content-end and duration. No audio crosses.
+ */
+object CatchUpPlanner {
+    /**
+     * Re-anchors [plan] ahead of [currentPositionSec], or null when no
+     * catch-up applies (not late, blocked, or too little left to mix).
+     *
+     * Lead is 0.9-1.5 s snapped to the next beat/downbeat after
+     * current+0.8 s when a grid exists (0.6 s when only 2.0-2.5 s remain,
+     * preserving room for a quick dissolve). Overlap shape:
+     * - >=7.0 s and tempo delta <=8%: 4-bar DJ_BLEND (bass swap + mid carve)
+     * - >=3.5 s or tempo >8%: 2-bar DJ_FILTER/ECHO_RIDE (filter + echo tail)
+     * - 1.2-3.5 s (djmix15, was 1.6): 1-bar quick blend/filter at full
+     *   available overlap — 0.6 s lead + 1.2-1.6 s DJ filter dissolve where
+     *   a 2.5 s floor would have played dry to EOF.
+     *
+     * Below 2.0 s of effective room (contentEnd-aware) there is no lead +
+     * dissolve that can breathe: return null so the planner blocks
+     * ("too-late-near-eof") instead of firing a stale micro-fade.
+     */
+    fun reanchor(
+        plan: TransitionPlan,
+        outAnalysis: TrackAnalysis,
+        inAnalysis: TrackAnalysis,
+        currentPositionSec: Double,
+        durationSec: Double,
+    ): TransitionPlan? {
+        if (plan.blocked) return null
+        if (durationSec <= 0.0 || !durationSec.isFinite() || !currentPositionSec.isFinite()) return null
+        if (currentPositionSec <= plan.transitionStart + 0.25) return null
+        if (currentPositionSec >= durationSec) return null
+
+        val contentEnd = outAnalysis.contentEndTime
+        val rawEnd = if (contentEnd.isFinite() && contentEnd > currentPositionSec + 2.0 && contentEnd > 0.0) {
+            contentEnd
+        } else {
+            durationSec
+        }
+        val effectiveEndSec = rawEnd.coerceAtMost(durationSec)
+        val remainingSec = effectiveEndSec - currentPositionSec
+        if (remainingSec < 2.0) return null
+
+        val outBpm = outAnalysis.bpm
+        val inBpm = inAnalysis.bpm
+        val bpmForBar = if (outBpm > 0) outBpm else if (inBpm > 0) inBpm else 120.0
+        val beatSec = if (bpmForBar > 0) 60.0 / bpmForBar else 0.5
+        val barSec = if (bpmForBar > 0) 4.0 * beatSec else 2.0
+
+        // Near-EOF quick blend: a snapped 0.9-1.5 s lead would leave <1.2 s
+        // to dissolve in. A fixed 0.6 s lead preserves 1.2-1.6 s of it.
+        val snapped = snappedLeadSec(outAnalysis, currentPositionSec)
+        val leadSec = if (remainingSec < 2.5) 0.6 else snapped
+        val catchUpStartSec = currentPositionSec + leadSec
+        // Guard-band 0.4 s keeps the tail off the file edge.
+        var availableOverlapSec = (effectiveEndSec - catchUpStartSec - 0.4).coerceAtLeast(1.2)
+        // Never let the overlap run past the track end.
+        val roomLeft = effectiveEndSec - catchUpStartSec
+        if (roomLeft < 1.2) return null
+        if (availableOverlapSec > roomLeft) availableOverlapSec = roomLeft
+        if (availableOverlapSec < 1.2) return null
+
+        val tempoDelta = if (outBpm > 0 && inBpm > 0) {
+            val fold = alignedFold(outBpm, inBpm)
+            val alignedIn = inBpm / fold
+            abs(alignedIn / outBpm - 1.0)
+        } else {
+            0.0
+        }
+
+        val (fadeSec, style) = when {
+            availableOverlapSec >= 7.0 && tempoDelta <= 0.08 -> {
+                val f = minOf(plan.fadeSeconds, availableOverlapSec, 4.0 * barSec)
+                // At least 2 bars when we claimed a 4-bar blend; shorter only if the room is short.
+                val clamped = f.coerceIn(minOf(4.0, availableOverlapSec), availableOverlapSec)
+                clamped to TransitionStyle.DJ_BLEND
+            }
+            availableOverlapSec >= 3.5 -> {
+                // 2-bar filter/echo ride, clamped to the club 3.5-8.0 s window.
+                val f = minOf(availableOverlapSec, 2.0 * barSec).coerceIn(3.5, 8.0)
+                // If the room is shorter than 3.5, take the full room (quick blend path).
+                val finalF = if (f > availableOverlapSec) availableOverlapSec else f
+                finalF to TransitionStyle.DJ_FILTER
+            }
+            else -> {
+                // 1-bar beat-snapped quick blend: full available overlap.
+                availableOverlapSec to TransitionStyle.DJ_FILTER
+            }
+        }
+        val endSec = catchUpStartSec + fadeSec
+        if (endSec > durationSec + 1e-6) return null
+        if (fadeSec < 1.2 || !fadeSec.isFinite()) return null
+        // Keep the original blend character where it fits; only the timing moves.
+        val baseReason = plan.reason.ifBlank { "smart-duration" }
+        return plan.copy(
+            shouldStart = false,
+            markerVisible = true,
+            blocked = false,
+            transitionStart = catchUpStartSec,
+            transitionEnd = endSec,
+            fadeSeconds = fadeSec,
+            transitionStyle = style,
+            reason = if (baseReason.endsWith(":catch-up")) baseReason else baseReason + ":catch-up",
+            beatSeconds = if (plan.beatSeconds > 0) plan.beatSeconds else beatSec,
+        )
+    }
+
+    /** Lead 0.9-1.5 s snapped to the next downbeat/beat after current+0.8 s. */
+    private fun snappedLeadSec(analysis: TrackAnalysis, currentSec: Double): Double {
+        val target = currentSec + 0.8
+        val maxLead = currentSec + 1.5
+        // Prefer explicit downbeats (both sides).
+        val grids = listOfNotNull(
+            analysis.downbeats.takeIf { it.isNotEmpty() },
+            analysis.headBeats?.downbeats?.takeIf { it.isNotEmpty() },
+            analysis.headBeats?.beats?.takeIf { it.isNotEmpty() },
+            analysis.tailBeats?.downbeats?.takeIf { it.isNotEmpty() },
+            analysis.tailBeats?.beats?.takeIf { it.isNotEmpty() },
+        )
+        for (grid in grids) {
+            val next = grid.firstOrNull { it.isFinite() && it >= target && it <= maxLead }
+            if (next != null) {
+                val lead = next - currentSec
+                if (lead in 0.9..1.5) return lead
+            }
+        }
+        // Synthesize from BPM + phase (firstBeat or first grid beat).
+        val bpm = analysis.bpm
+        if (bpm > 0) {
+            val beatSec = 60.0 / bpm
+            if (beatSec > 0.1) {
+                val anchor = when {
+                    analysis.firstBeat.isFinite() && analysis.firstBeat > 0.0 -> analysis.firstBeat
+                    analysis.downbeats.isNotEmpty() -> analysis.downbeats.firstOrNull { it.isFinite() } ?: 0.0
+                    analysis.headBeats?.beats?.isNotEmpty() == true -> analysis.headBeats.beats.firstOrNull { it.isFinite() } ?: 0.0
+                    else -> 0.0
+                }
+                // Next beat >= target on the anchor+ k*beat lattice.
+                val k = kotlin.math.ceil((target - anchor) / beatSec)
+                val snapped = anchor + k.coerceAtLeast(0.0) * beatSec
+                val lead = snapped - currentSec
+                if (lead in 0.9..1.5) return lead
+            }
+        }
+        return 1.0
+    }
+}
+
+/**
+ * djmix16 catch-up pin (pure, scalars only). Any :catch-up plan for a
+ * (pair, scrubEpoch) is pinned ONCE and reused on every subsequent IDLE
+ * tick for that key — never recomputed as playbackTime + lead, which
+ * pushed transitionStart forward every tick (fadeSec 4.59 -> 3.98 ->
+ * 2.26 -> 1.2 on Never Let Go -> S.A.D) and kept `remaining` at +900 ms
+ * so pos never caught the start. The caller drops the pin on pair or
+ * scrubEpoch change; the pin otherwise holds until the mix arms or any
+ * valid non-catch-up plan arrives (djmix17).
+ */
+object CatchUpPins {
+    /** Key for a pair at a scrub epoch. */
+    fun key(pairKey: String, scrubEpoch: Long): String = "$pairKey|$scrubEpoch"
+
+    /**
+     * Pinned plan when it matches [currentKey], else null (store [currentPlan]).
+     * The pin freezes transitionStart/fade/style by design, but
+     * [TransitionPlan.shouldStart] must still track the playhead: a plan
+     * pinned at pos < start (shouldStart=false) flips to true once
+     * [currentPositionMs] reaches the pinned start. Without this the pinned
+     * plan reads never-started forever even though remaining <= 0 and
+     * classic begin() fires on the remaining gate.
+     */
+    fun reuse(
+        pinned: TransitionPlan?,
+        pinnedKey: String?,
+        currentKey: String,
+        currentPositionMs: Long? = null,
+    ): TransitionPlan? {
+        if (pinned == null || pinnedKey != currentKey) return null
+        if (currentPositionMs == null) return pinned
+        val startMs = (pinned.transitionStart * 1000).roundToLong()
+        if (currentPositionMs >= startMs) {
+            return if (pinned.shouldStart) pinned else pinned.copy(shouldStart = true)
+        }
+        return pinned
+    }
+
+    /**
+     * True when a valid non-catch-up plan drops the pin. ANY such plan
+     * drops it — new pair, or the same pair after an interior -> final
+     * anchor flip or a backward seek. While the playhead is past the
+     * anchor, planTransition ALWAYS returns :catch-up, so a same-pair
+     * non-catch-up plan can only mean transitionStart moved AHEAD of
+     * playbackTime; keeping the old pin would resurrect a stale
+     * interior-anchor catch-up when the new anchor is later crossed
+     * (Never Let Go: seq368 final anchor 181.6 s non-catch-up, then
+     * seq369 reused the stale 164.6 s interior pin).
+     */
+    fun dropOnNonCatchUp(pinnedKey: String?, pairKey: String): Boolean =
+        pinnedKey != null
+}
