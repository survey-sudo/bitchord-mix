+                ?: outAnalysis?.headBeats?.beats
+            val outLoopTracked = if (plan.outLoops && plan.out.beats > 0) {
+                trackedBeatsInWindow(outSideBeats, plan.out.loopStart, plan.out.beats, plan.out.beatSec)
