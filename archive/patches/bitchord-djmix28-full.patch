+class AutomixFreezeTest {
+
+    private fun track(id: String = "t1") = TransitionTrackInfo(id = id, durationMs = 200_000L)
+
+    // ---- analysis trust (P0 #4) ----
+
+    @Test fun blankStatusIsNotReady() {
