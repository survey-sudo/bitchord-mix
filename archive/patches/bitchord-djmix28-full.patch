+            val inSideBeats = inAnalysis?.headBeats?.beats?.takeIf { it.isNotEmpty() }
+                ?: inAnalysis?.tailBeats?.beats
+            if (plan.rung != "Echo" && !plan.inLoops && inSideBeats != null) {
+                val holdIdx = if (clock.incomingHoldSec > 1e-9) {
