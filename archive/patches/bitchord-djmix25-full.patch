+    private fun tone(n: Int, rate: Int, amplitude: Double): FloatArray {
+        val out = FloatArray(n)
+        for (i in 0 until n) out[i] = (sin(2.0 * PI * 440.0 * i / rate) * amplitude).toFloat()
+        return out
+    }
