+    private fun findIds(slot: Int, limit: Int = 500): Pair<String, String> {
+        for (i in 0 until limit) {
+            val a = "djmix24-out-$i"
+            val b = "djmix24-in"
+            if (TransitionMoves.fxSlot(a, b) == slot) return a to b
+        }
+        error("no ids for slot $slot")
+    }
