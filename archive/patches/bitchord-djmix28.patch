+## Qualcomm AI (QAIRT) HTP runtime
+
+The Snapdragon NPU stack is the QAIRT 2.51.0.260929 HTP runtime, bundled
+in the APK under lib/arm64-v8a (libQnnHtp*, plus one Skel per Hexagon
+generation), built against the ONNX Runtime 1.31.0 source build in
+npu-addon/. Qualcomm AI Runtime is the property of Qualcomm
+Technologies, Inc. and/or its subsidiaries and is governed by the
+license in app/src/main/assets/licenses/Qualcomm-AI-Runtime-LICENSE.pdf
+and the notices in Qualcomm-AI-Runtime-QNN-NOTICE.txt. All rights
+reserved; no rights are granted except as stated in that license.
diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index e8ffb28..5d9fb26 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -127,7 +127,15 @@ android {
     // The phone <-> watch protocol, one file shared with the watch app so the
     // two cannot drift. See wearos/protocol/.../WearProtocol.kt.
     sourceSets {
-        getByName("main") { java.srcDir("../wearos/protocol") }
+        getByName("main") {
+            java.srcDir("../wearos/protocol")
+            // Bundled QNN stack (QAIRT libQnn*.so plus skels plus the
+            // from-source libonnxruntime.so) built by npu-addon/build-ort.sh.
+            // A fresh checkout without it builds CPU-only and the NPU
+            // silently stays off, which is the fallback contract. See
+            // npu-addon/README.md.
+            jniLibs.srcDir(rootProject.file("npu-addon/prebuilt/jniLibs"))
+        }
     }
 
     externalNativeBuild {
@@ -224,6 +232,16 @@ android {
         targetCompatibility = JavaVersion.VERSION_17
     }
     packaging {
+        // The QNN-capable libonnxruntime.so from npu-addon/prebuilt wins over
+        // the full library in the onnxruntime-android AAR (Orchard does the
+        // same pickFirsts trick). Packed compressed through legacy packaging
+        // so the 88 MB libQnnHtpPrepare.so and the two 13 MB skels stay
+        // around 60 MB in the APK instead of around 170 MB; extractNativeLibs
+        // in the manifest materialises them for dlopen-by-path and the DSP.
+        jniLibs {
+            pickFirsts += "**/libonnxruntime.so"
+            useLegacyPackaging = true
+        }
         resources {
             // SMBJ's BouncyCastle and jspecify both ship this descriptor.
             excludes += "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
@@ -430,7 +448,10 @@ dependencies {
     // The full android artifact, not onnxruntime-mobile: mobile only loads .ort
     // files, which would put an offline conversion step between the model and
     // the app for a saving that does not matter in a self-distributed APK.
-    implementation("com.microsoft.onnxruntime:onnxruntime-android:1.28.0")
+    // Version mirrors Orchard (mobile/android/app/build.gradle): 1.31.0 pairs
+    // with the from-source QNN build in npu-addon/build-ort.sh, whose
+    // libonnxruntime.so wins over the AAR one via the jniLibs pickFirsts below.
+    implementation("com.microsoft.onnxruntime:onnxruntime-android:1.31.0")
 
     // ---- Casting: Google Cast sender + the route discovery it sits on ----
     // The framework and the router only. media3-cast is left out on purpose:
