+        val loudP = plan(loudOut, loudIn)
+        assertTrue("measured vocals must decorate the blend", loudP.vocalDepthCurve.isNotEmpty())
+        assertTrue(loudP.vocalDepthCurve.zipWithNext().all { (a, b) -> b >= a - 1e-9 })
