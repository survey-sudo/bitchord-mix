+                        val ease = 0.5 * (1.0 - kotlin.math.cos(kotlin.math.PI * u))
+                        val rateK = endRate + (1.0 - endRate) * ease
+                        inPositionsSec[k] = inPositionsSec[k - 1] + dt * rateK
+                    }
+                }
+            }
