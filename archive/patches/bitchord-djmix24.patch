+class Djmix24AppTest {
+
+    private fun exitCue(room: Int = 8) = ExitCue(
+        kind = ExitKind.OUTRO_PHRASE,
+        releaseBar = 72,
+        releaseSec = 170.0,
+        roomBars = room,
+        vocalRoomBars = 0,
+        tailBars = 0,
+        sectionFn = SectionFn.OUTRO,
+        role = SectionRole.GROOVE,
+        energyAtRelease = 0.4f,
+        energyLevel = 4,
+        loopableRoom = room >= 4,
+        cutsSungBars = 0,
+        cutsBars = 0,
+    )
+
+    private fun entryCue() = EntryCue(
