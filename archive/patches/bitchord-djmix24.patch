+                    FloatArray((180.0 * com.music.bitchord.playback.smart.LEVEL_FRAME_RATE).toInt()) {
+                        com.music.bitchord.playback.smart.levelFromRms(0.3).toFloat()
+                    },
+                ),
+            ),
+        )
+    }
+}
