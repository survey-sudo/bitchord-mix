+        landingRole = SectionRole.GROOVE,
+        leadInBars = 8,
+        leadInVocal = 0f,
+        leadInLoopable = true,
+        energyAtLanding = 0.4f,
+        energyLevel = 4,
+        trimmedBars = 0,
+        pickupBeats = 0f,
+    )
+
+    private fun choice(vocalOverlap: Double = 0.0): PhraseChoice = PhraseChoice(
