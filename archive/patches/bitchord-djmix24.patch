+    private fun analysis(
+        bpm: Double,
+        duration: Double,
+        trackId: String = "t",
+        vocals: List<CurveWindow> = emptyList(),
+        quiet: List<Pair<Double, Double>> = emptyList(),
+    ) = TrackAnalysis(
+        status = TrackAnalysis.STATUS_READY,
+        trackId = trackId,
+        duration = duration,
+        bpm = bpm,
+        beatInterval = 60 / bpm,
+        beatConfidence = 0.8,
+        downbeats = listOf(0.5),
+        firstBeat = 0.5,
+        vocalWindows = vocals,
+        levelWindows = levels(duration, quiet),
+    )
