+        )
+        assertTrue(early.reason.contains("fallback"), "early must fallback: ${early.reason}")
+        // Late/scrub: 40 s left (<=45) — HEAD rescue into a real mix, not fallback.
+        val late = planTransition(
+            analysis = outHead, nextAnalysis = innFull,
