+            val p = i.toFloat() / steps
+            val g = MixGain.fall(p).toDouble()
+            val db = (last + 20.0 * kotlin.math.log10(g.coerceAtLeast(1e-6))).toFloat().coerceAtLeast(mute - 6f)
