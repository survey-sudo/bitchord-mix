+
+    private fun entryCue(startBar: Int = 0, startSec: Double = 0.0, landingBar: Int = 8) = EntryCue(
+        kind = EntryKind.HEAD,
+        startBar = startBar,
+        startSec = startSec,
+        landingBar = landingBar,
+        landingFn = SectionFn.INTRO,
+        landingRole = SectionRole.GROOVE,
+        leadInBars = landingBar - startBar,
+        leadInVocal = 0f,
