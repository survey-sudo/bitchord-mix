+    // ---- fixtures (mirror PhrasePlannerTest) ----
+
+    private fun section(start: Int, end: Int, fn: SectionFn, role: SectionRole, energy: Int) =
+        PhraseSection(start, end, fn, role, 0.8f, 0, 0, energy / 10f, energy, 0f, 0f, 0f, 0.4f, false)
